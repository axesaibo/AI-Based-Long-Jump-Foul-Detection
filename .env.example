# =============================================================================
# Long Jump Foul Detection System — Environment Variables (Template)
# =============================================================================
# Copy this file to .env and fill in your values:
#     cp .env.example .env
#
# This project does not require environment variables by default.
# All configuration is handled via config.yaml.
#
# If you extend the project (e.g., cloud storage, API integrations),
# add your variables below.
# =============================================================================

# Example: path override for the model weights
# MODEL_WEIGHTS_PATH=models/shoe_seg.pt

# Example: custom output directory
# OUTPUT_DIR=output
